{
    "name": "vendor/quicksnap",
    "description": "quicksnap",
    "type": "n",
    "license": "n",
    "autoload": {
        "psr-4": {
            "WTDQS_Quicksnap\\Admin\\": "Admin/",
            "WTDQS_Quicksnap\\Includes\\": "Includes/",
